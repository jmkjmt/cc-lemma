(
(data Bool (True False))
(:: True Bool)
(:: False Bool)
(data Nat (Z S))
(:: Z Nat)
(:: S (-> (Nat) Nat))
(data List (Nil Cons))
(:: Nil List)
(:: Cons (-> (Nat List) List))
(:: append (-> (List List) List))
(let append (Nil ?ys) ?ys)
(let append ((Cons ?x ?xs) ?ys) (Cons ?x (append ?xs ?ys)))
(:: ite-list (-> (Bool List List) List))
(let ite-list (True ?x ?y) ?x)
(let ite-list (False ?x ?y) ?y)
(:: eq (-> (Nat Nat) Bool))
(let eq (Z Z) True)
(let eq (Z (S ?y)) False)
(let eq ((S ?x) Z) False)
(let eq ((S ?x) (S ?y)) (eq ?x ?y))
(:: not (-> (Bool) Bool))
(let not (True) False)
(let not (False) True)
(:: filter (-> ((-> (Nat) Bool) List) List))
(let filter (?pred Nil) Nil)
(let filter (?pred (Cons ?hd ?tl)) (ite-list ($ ?pred ?hd) (Cons ?hd (filter ?pred ?tl)) (filter ?pred ?tl)))
(:: sol121 (-> ((-> (Nat) Bool) List) List))
(let sol121 (?pred ?lst) (reverse (loop ?pred ?lst Nil) Nil))
(:: loop (-> ((-> (Nat) Bool) List List) List))
(let loop (?pred Nil ?o) ?o)
(let loop (?pred (Cons ?h ?t) ?o) (loop ?pred ?t (ite-list ($ ?pred ?h) (Cons ?h ?o) ?o)))
(:: reverse (-> (List List) List))
(let reverse (Nil ?o) ?o)
(let reverse ((Cons ?h ?t) ?o) (reverse ?t (Cons ?h ?o)))
(:: even (-> (Nat) Bool))
(let even (Z) True)
(let even ((S Z)) False)
(let even ((S (S ?n))) (even ?n))
(:: sol171 (-> ((-> (Nat) Bool) List) List))
(let sol171 (?pred ?lst) (aux ?pred (S Z) ?lst))
(:: aux (-> ((-> (Nat) Bool) Nat List) List))
(let aux (?pred ?i Nil) Nil)
(let aux (?pred ?i (Cons ?h ?t)) (ite_list ($ ?pred ?h) (Cons ?h (aux ?pred (S ?i) ?t)) (aux ?pred (S ?i) ?t)))
(=== sol1-sol121 (lst pred) (List (-> (Nat) Bool)) (filter pred lst) (sol121 pred lst))
(=== sol1-sol171 (lst pred) (List (-> (Nat) Bool)) (filter pred lst) (sol171 pred lst))
(=== sol121-sol171 (lst pred) (List (-> (Nat) Bool)) (sol121 pred lst) (sol171 pred lst))
)