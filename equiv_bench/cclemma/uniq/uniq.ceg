(
    (data Bool (True False))
    (:: True Bool)
    (:: False Bool)

    (data Nat (Z S))
    (:: Z Nat)
    (:: S (-> (Nat) Nat))
    
    (data List (Nil Cons))
    (:: Nil List)
    (:: Cons (-> (Nat List) List))

(:: ite-bool (-> (Bool Bool Bool) Bool))
(let ite-bool (True ?x ?y) ?x)
(let ite-bool (False ?x ?y) ?y)

(:: ite-nat (-> (Bool Nat Nat) Nat))
(let ite-nat (True ?x ?y) ?x)
(let ite-nat (False ?x ?y) ?y)
(:: ite-list (-> (Bool List List) List))
(let ite-list (True ?x ?y) ?x)
(let ite-list (False ?x ?y) ?y)


    (:: list-append (-> (List List) List))
    (let list-append (Nil           ?ys) ?ys                       )
    (let list-append ((Cons ?x ?xs) ?ys) (Cons ?x (list-append ?xs ?ys)))

    (:: list-rev (-> (List) List))
    (let list-rev (Nil          ) Nil                             )
    (let list-rev ((Cons ?x ?xs)) (list-append (list-rev ?xs) (Cons ?x Nil)))

    (:: eq (-> (Nat Nat) Bool))
    (let eq (Z      Z     ) True      )
    (let eq (Z      (S ?y)) False     )
    (let eq ((S ?x) Z     ) False     )
    (let eq ((S ?x) (S ?y)) (eq ?x ?y))

    (:: and (-> (Bool Bool) Bool))
    (let and (False ?y) False)
    (let and (?x False) False)
    (let and (True True) True)

    (:: or (-> (Bool Bool) Bool))
    (let or (True ?y) True)
    (let or (?x True) True)
    (let or (False False) False)

    (:: not (-> (Bool) Bool))
    (let not (True) False)
    (let not (False) True)

    (:: remove-elem-1 (-> (Nat List) List))
    (let remove-elem-1 (?e Nil) Nil)
    (let remove-elem-1 (?e (Cons ?hd ?tl)) (ite-nat (eq ?e ?hd) (remove-elem-1 ?e ?tl) (Cons ?hd (remove-elem-1 ?e ?tl))))


    (:: ta1 (-> (List) List))
    (let ta1 (Nil) Nil)
    (let ta1 ((Cons ?hd ?tl)) (Cons ?hd (remove-elem-1 ?hd (ta1 ?tl))))

    (:: drop2 (-> (List Nat) List))
    (let drop2 (Nil ?n) Nil)
    (let drop2 ((Cons ?hd ?tl) ?n) (ite-nat (eq ?hd ?n) (drop2 ?tl ?n) (Cons ?hd (drop2 ?tl ?n))))

    (:: ta2 (-> (List) Nat))
    (let ta2 (Nil) Nil)
    (let ta2 ((Cons ?hd ?tl)) (Cons ?hd (ta2 (drop2 ?tl ?hd))))

    (:: isin3 (-> (List Nat) Bool))
    (let isin3 (Nil ?a) False)
    (let isin3 ((Cons ?hd ?tl) ?a) (ite-bool (eq ?a ?hd) True (isin3 ?tl ?a)))

    (:: unique3 (-> (List List) List))
    (let unique3 (Nil ?lst2) ?lst2)
    (let unique3 ((Cons ?hd ?tl) ?lst2) (ite-list (isin3 ?lst2 ?hd) (unique3 ?tl ?lst2) (unique3 ?tl (list-append ?lst2 (Cons ?hd Nil)))))

    (:: ta3 (-> (List) List))
    (let ta3 (?lst) (unique3 ?lst Nil))

    (:: isnotin4 (-> (List Nat) Bool))
    (let isnotin4 (Nil ?c) True)
    (let isnotin4 ((Cons ?hd ?tl) ?c) (ite-bool (eq ?hd ?c) False (isnotin4 ?tl ?c)))

    (:: uniqsave4 (-> (List List) List))
    (let uniqsave4 (Nil ?l2) ?l2)
    (let uniqsave4 ((Cons ?hd ?tl) ?l2) (ite-list (isnotin4 ?l2 ?hd) (uniqsave4 ?tl (list-append ?l2 (Cons ?hd Nil))) (uniqsave4 ?tl ?l2)))

    (:: ta4 (-> (List) List))
    (let ta4 (?lst) (uniqsave4 ?lst Nil))

    (:: sol4 (-> (List) List))
    (let sol4 (?lst) (app ?lst Nil))

    (:: app (-> (List List) List))
    (let app (Nil ?l2) ?l2)
    (let app ((Cons ?hd ?tl) ?l2) (app ?tl (comb ?l2 ?hd)))

    (:: comb (-> (List Nat) List))
    (let comb (Nil ?a) (Cons ?a Nil))
    (let comb ((Cons ?hd ?tl) ?a) (ite-list (eq ?hd ?a) (Cons ?hd ?tl) (Cons ?hd (comb ?tl ?a))))

    (:: chk (-> (List Nat) Bool))
    (let chk (Nil ?a) True)
    (let chk ((Cons ?hd ?tl) ?a) (ite-bool (eq ?hd ?a) False (chk ?tl ?a)))

    (:: del (-> (List Nat) List))
    (let del (Nil ?a) Nil)
    (let del ((Cons ?hd ?tl) ?a) (ite-list (eq ?hd ?a) (del ?tl ?a) (Cons ?hd (del ?tl ?a))))

    (:: sol5 (-> (List) List))
    (let sol5 (Nil) Nil)
    (let sol5 ((Cons ?hd ?tl)) (ite-list (chk ?tl ?hd) (Cons ?hd (sol5 ?tl)) (Cons ?hd (sol5 (del ?tl ?hd)))))

    (:: fastrev (-> (List) List))
    (let fastrev (?lst) (rev ?lst Nil))
    (:: rev (-> (List List) List))
    (let rev (Nil ?acc) ?acc)
    (let rev ((Cons ?hd ?tl) ?acc) (rev ?tl (list-append (Cons ?hd Nil) (?acc))))
    
    (:: search (-> (List Nat) Bool))
    (let search (Nil ?e) False)
    (let search ((Cons ?hd ?tl) ?e) (ite-bool (eq ?hd ?e) True (search ?tl ?e)))

    (:: delete9 (-> (List) List))
    (let delete9 (Nil) Nil)
    (let delete9 ((Cons ?hd ?tl)) (ite-list (search ?tl ?hd) (delete9 ?tl) (list-append (Cons ?hd Nil) (delete9 ?tl))))

    (:: sol9 (-> (List) List))
    (let sol9 (?lst) (fastrev (delete9 (fastrev ?lst))))

    (:: sol20 (-> (List) List))
    (let sol20 (?lst) (aux20 (list-rev ?lst)))
    (:: aux20 (-> (List) List))
    (let aux20 (Nil) Nil)
    (let aux20 ((Cons ?hd ?tl)) (ite-list (find ?hd ?tl) (sol20 (list-rev ?tl)) (list-append (sol20 (list-rev ?tl)) (Cons ?hd Nil))))
    (:: find (-> (Nat List) Bool))
    (let find (?x Nil) False)
    (let find (?x (Cons ?hd ?tl)) (or (eq ?x ?hd) (find ?x ?tl)))

    (:: sol43 (-> (List) List))
    (let sol43 (Nil) Nil)
    (let sol43 ((Cons ?hd ?tl)) (Cons ?hd (sol43 (filter43 aux43 ?hd ?tl))))
  
    (:: aux43 (-> (Nat Nat) Bool))
    (let aux43 (?x ?hd) (not (eq ?x ?hd)))
    (:: filter43 (-> ((-> (Nat Nat) Nat) (Nat) List) List))
    (let filter43 (?f ?a ?l) (sub-aux43 Nil ?f ?a ?l))

    (:: sub-aux43 (-> (List (-> (Nat Nat) Bool) (Nat) List ) List))
    (let sub-aux43 (?s ?f ?a Nil) ?s)
    (let sub-aux43 (?s ?f ?a (Cons ?hd ?tl)) (ite-list ($ ($ ?f ?hd) ?a) (list-append ?s (Cons ?hd (filter43 ?f ?a ?tl))) (list-append ?s (filter43 ?f ?a ?tl))))

    (:: sol57 (-> (List) List))
    (let sol57 (?lst) (putIn ?lst Nil))
    (:: putIn (-> (List List) List))
    (let putIn (Nil ?lst2) ?lst2)
    (let putIn ((Cons ?hd ?tl) ?lst2) (putIn ?tl (check ?hd ?lst2)))
    (:: check (-> (Nat List) List))
    (let check (?item Nil) (Cons ?item Nil))
    (let check (?item (Cons ?hd ?tl)) (ite-list (eq ?hd ?item) (Cons ?hd ?tl) (Cons ?hd (check ?item ?tl))))

    (:: reverse (-> (List) List))
    (let reverse (Nil) Nil)
    (let reverse ((Cons ?hd ?tl)) (list-append (reverse ?tl) (Cons ?hd Nil)))
    (:: insert (-> (Nat List) List))
    (let insert (?a Nil) (Cons ?a Nil))
    (let insert (?a (Cons ?hd ?tl)) (ite-list (lt ?a ?hd) (Cons ?a (Cons ?hd ?tl)) (Cons ?hd (insert ?a ?tl))))
    (:: checker (-> (List Nat) Bool))
    (let checker (Nil ?a) False)
    (let checker ((Cons ?k Nil) ?a) (eq ?k ?a))
    (let checker ((Cons ?hd ?tl) ?a) (ite-bool (eq ?hd ?a) True (checker ?tl ?a)))
    (:: finder (-> (List List) List))
    (let finder (Nil ?fin) ?fin)
    (let finder ((Cons ?hd ?tl) ?fin) (ite-list (checker ?fin ?hd) (finder ?tl ?fin) (finder ?tl (Cons ?hd ?fin))))
    (:: sol75 (-> (List) List))
    (let sol75 (Nil) Nil)
    (let sol75 (?lst) (reverse (finder ?lst Nil)))
    
    (:: sol89 (-> (List) List))
    (let sol89 (?lst) (reverse89 (checkdrop89 ?lst Nil) Nil))
    (:: reverse89 (-> (List List) List))
    (let reverse89 (Nil ?a) ?a)
    (let reverse89 ((Cons ?hd ?tl) ?a) (reverse89 ?tl (Cons ?hd ?a)))
    (:: checkdrop89 (-> (List List) List))
    (let checkdrop89 (Nil ?l) ?l)
    (let checkdrop89 ((Cons ?hd ?tl) ?l) (ite-list (gtl ?hd ?l) (checkdrop89 ?tl ?l) (checkdrop89 ?tl (Cons ?hd ?l))))
    (:: gtl (-> (Nat List) Bool))
    (let gtl (?e Nil) False)
    (let gtl (?e (Cons ?h ?t)) (ite-bool (eq ?e ?h) True (gtl ?e ?t)))

    (:: sol101 (-> (List) List))
    (let sol101 (?lst) (fold-left aux101 Nil ?lst))
    (:: aux101 (-> (List (Nat)) List))
    (let aux101 (?a ?x) (ite-list (has-element ?a ?x) ?a (list-append ?a (Cons ?x Nil))))
    (:: has-element (-> (List Nat) Bool))
    (let has-element (Nil ?e) False)
    (let has-element ((Cons ?hd ?tl) ?e) (or (eq ?hd ?e) (has-element ?tl ?e)))
    (:: fold-left (-> ((-> (List Nat) Bool) (Nat) List) List))
    (let fold-left (?f ?a Nil) ?a)
    (let fold-left (?f ?a (Cons ?h ?t)) (fold-left ?f ($ ($ ?f ?a) ?h) ?t))
