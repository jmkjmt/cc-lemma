(
(data Bool (True False))
(:: True Bool)
(:: False Bool)
(data Nat (Z S))
(:: Z Nat)
(:: S (-> (Nat) Nat))
(data Lambda (V P C))
(:: V (-> (Nat) Lambda))
(:: P (-> (Nat Lambda) Lambda))
(:: C (-> (Lambda Lambda) Lambda))
(data List (Nil Cons))
(:: Nil List)
(:: Cons (-> (Nat List) List))
(:: plus (-> (Nat Nat) Nat))
(let plus (Z ?y) ?y)
(let plus ((S ?x) ?y) (S (plus ?x ?y)))
(:: eqlist (-> (List List) Bool))
(let eqlist ((Cons ?hd ?tl) (Cons ?hd2 ?tl2)) (ite-bool (eq ?hd ?hd2) (eqlist ?tl ?tl2) (False)))
(let eqlist ((Cons ?hd ?tl) Nil) False)
(let eqlist (Nil (Cons ?hd ?tl)) False)
(let eqlist (Nil Nil) True)
(:: ite-bool (-> (Bool Bool Bool) Bool))
(let ite-bool (True ?x ?y) ?x)
(let ite-bool (False ?x ?y) ?y)
(:: ite-nat (-> (Bool Nat Nat) Nat))
(let ite-nat (True ?x ?y) ?x)
(let ite-nat (False ?x ?y) ?y)
(:: ite-list (-> (Bool List List) List))
(let ite-list (True ?x ?y) ?x)
(let ite-list (False ?x ?y) ?y)
(:: eq (-> (Nat Nat) Bool))
(let eq (Z Z) True)
(let eq (Z (S ?y)) False)
(let eq ((S ?x) Z) False)
(let eq ((S ?x) (S ?y)) (eq ?x ?y))
(:: not (-> (Bool) Bool))
(let not (True) False)
(let not (False) True)
(:: append (-> (List List) List))
(let append (Nil ?ys) ?ys)
(let append ((Cons ?x ?xs) ?ys) (Cons ?x (append ?xs ?ys)))
(:: mem (-> (Nat List) Bool))
(let mem (?n Nil) False)
(let mem (?n (Cons ?x ?xs)) (ite-bool (eq ?n ?x) True (mem ?n ?xs)))
(:: and (-> (Bool Bool) Bool))
(let and (False ?y) False)
(let and (?x False) False)
(let and (True True) True)
(:: or (-> (Bool Bool) Bool))
(let or (True ?y) True)
(let or (?x True) True)
(let or (False False) False)
(:: check1 (-> (Lambda List) Bool))
(let check1 ((V ?x) ?lst) (mem ?x ?lst))
(let check1 ((P ?x ?e) ?lst) (check1 ?e (Cons ?x ?lst)))
(let check1 ((C ?e1 ?e2) ?lst) (and (check1 ?e1 ?lst) (check1 ?e2 ?lst)))
(:: ta1 (-> (Lambda) Bool))
(let ta1 (?lambda) (check1 ?lambda Nil))
(:: ta2 (-> (Lambda) Bool))
(let ta2 ((V ?x)) False)
(let ta2 ((P ?x ?e)) (check1 ?e (Cons ?x Nil)))
(let ta2 ((C ?e1 ?e2)) (and (check1 ?e1 Nil) (check1 ?e2 Nil)))
(:: check3 (-> (Lambda List) Bool))
(let check3 ((P ?st ?k) ?li) (ite-bool (mem ?st ?li) (check3 ?k ?li) (check3 ?k (Cons ?st ?li))))
(let check3 ((C ?me1 ?me2) ?li) (and (check3 ?me1 ?li) (check3 ?me2 ?li)))
(let check3 ((V ?na) ?li) (mem ?na ?li))
(:: ta3 (-> (Lambda) Bool))
(let ta3 (?lambda) (check3 ?lambda Nil))
(:: exist (-> ((-> (Nat) Bool) List) Bool))
(let exist (?p Nil) False)
(let exist (?p (Cons ?hd ?tl)) (or ($ ?p ?hd) (exist ?p ?tl)))
(:: check4 (-> (Lambda List) Bool))
(let check4 ((P ?st ?k) ?li) (check4 ?k (Cons ?st ?li)))
(let check4 ((C ?me1 ?me2) ?li) (and (check4 ?me1 ?li) (check4 ?me2 ?li)))
(let check4 ((V ?na) ?li) (exist ($ eq ?na) ?li))
(:: ta4 (-> (Lambda) Bool))
(let ta4 ((P ?st ?k)) (check4 ?k (Cons ?st Nil)))
(let ta4 ((C ?me1 ?me2)) (and (check4 ?me1 Nil) (check4 ?me2 Nil)))
(let ta4 ((V ?na)) False)
(:: list-filter (-> ((-> (Nat Nat) Bool) Nat List) List))
(let list-filter (?p ?x Nil) Nil)
(let list-filter (?p ?x (Cons ?hd ?tl)) (ite-list ($ ($ ?p ?x) ?hd) (Cons ?hd (list-filter ?p ?x ?tl)) (list-filter ?p ?x ?tl)))
(:: aux (-> (Nat Nat) Bool))
(let aux (?n ?m) (not (eq ?n ?m)))
(:: getStn (-> (Lambda) List))
(let getStn ((V ?var)) (Cons ?var Nil))
(let getStn ((P ?n ?m)) (list-filter aux ?n (getStn ?m)))
(let getStn ((C ?m1 ?m2)) (append (getStn ?m1) (getStn ?m2)))
(:: sol5 (-> (Lambda) Bool))
(let sol5 (?lambda) (eqlist (getStn ?lambda) Nil))
(:: valify (-> (Nat Lambda) Bool))
(let valify (?var (V ?n)) False)
(let valify (?var (P ?n ?m)) (ite-bool (eq ?n ?var) True (valify ?var ?m)))
(let valify (?var (C ?m1 ?m2)) False)
(:: findStation (-> (Lambda Lambda) Bool))
(let findStation ((V ?n) ?covers) (valify ?n ?covers))
(let findStation ((P ?n ?m) ?covers) (findStation ?m (P ?n ?covers)))
(let findStation ((C ?m1 ?m2) ?covers) (and (findStation ?m1 ?covers) (findStation ?m2 ?covers)))
(:: sol50 (-> (Lambda) Bool))
(let sol50 (?m) (findStation ?m (V Z)))
(:: deleteAll (-> (List Nat) List))
(let deleteAll (Nil ?target) Nil)
(let deleteAll ((Cons ?hd ?tl) ?target) (ite-list (eq ?hd ?target) (deleteAll ?tl ?target) (Cons ?hd (deleteAll ?tl ?target))))
(:: listStation (-> (Lambda) List))
(let listStation ((V ?n)) (Cons ?n Nil))
(let listStation ((P ?n ?m)) (deleteAll (listStation ?m) ?n))
(let listStation ((C ?m1 ?m2)) (append (listStation ?m1) (listStation ?m2)))
(:: sol57 (-> (Lambda) Bool))
(let sol57 (?l) (eqlist (listStation ?l) Nil))
(:: aux101 (-> (Nat List) Bool))
(let aux101 (?x ?al) (mem ?x ?al))
(:: forall101 (-> ((-> (Nat List) Bool) List List) Bool))
(let forall101 (?pred ?a Nil) True)
(let forall101 (?pred ?a (Cons ?hd ?tl)) (ite-bool ($ ($ ?pred ?hd) ?a) (forall101 ?pred ?a ?tl) False))
(:: check101 (-> (Lambda List List) Bool))
(let check101 ((V ?n) ?al ?nl) (forall101 aux101 ?al (Cons ?n ?nl)))
(let check101 ((P ?n ?m) ?al ?nl) (check101 ?m (Cons ?n ?al) ?nl))
(let check101 ((C ?m1 ?m2) ?al ?nl) (and (check101 ?m1 ?al ?nl) (check101 ?m2 ?al ?nl)))
(:: sol101 (-> (Lambda) Bool))
(let sol101 (?m) (check101 ?m Nil Nil))
(// sol101 is something wrong.... //)
(:: varExists (-> (Nat List) Bool))
(let varExists (?var Nil) False)
(let varExists (?var (Cons ?h ?t)) (ite-bool (eq ?var ?h) True (varExists ?var ?t)))
(:: addToNameList (-> (Nat List) List))
(let addToNameList (?var ?lst) (ite-list (varExists ?var ?lst) ?lst (Cons ?var ?lst)))
(:: checkRec (-> (Lambda List) Bool))
(let checkRec ((V ?var) ?lst) (varExists ?var ?lst))
(let checkRec ((P ?var ?l) ?lst) (checkRec ?l (addToNameList ?var ?lst)))
(let checkRec ((C ?l1 ?l2) ?lst) (and (checkRec ?l1 ?lst) (checkRec ?l2 ?lst)))
(:: sol109 (-> (Lambda) Bool))
(let sol109 (?l) (checkRec ?l Nil))
(:: is-connect (-> (Lambda) Bool))
(let is-connect ((V ?n)) False)
(let is-connect ((C ?l1 ?l2)) True)
(let is-connect ((P ?v ?l)) (is-connect ?l))
(:: get-left (-> (Lambda) Lambda))
(let get-left ((V ?n)) (V ?n))
(let get-left ((C ?l1 ?l2)) ?l1)
(let get-left ((P ?v ?l)) (P ?v (get-left ?l)))
(:: get-right (-> (Lambda) Lambda))
(let get-right ((V ?n)) (V ?n))
(let get-right ((C ?l1 ?l2)) ?l2)
(let get-right ((P ?v ?l)) (P ?v (get-right ?l)))
(:: match123 (-> (Lambda Nat) Bool))
(let match123 ((V ?s) ?var) (ite-bool (eq ?var ?s) True False))
(let match123 ((C ?l1 ?l2) ?var) (and (sol123 (P ?var ?l1)) (sol123 (P ?var ?l2))))
(let match123 ((P ?v ?l) ?var) (or (sol123 (P ?var ?l)) (sol123 (P ?v ?l))))
(:: sol123 (-> (Lambda) Bool))
(let sol123 (?m) (ite-bool (is-connect ?m) (and (sol123 (get-left ?m)) (sol123 (get-right ?m))) (aux123 ?m)))
(let aux123 ((V ?n)) False)
(let aux123 ((C ?l ?r)) (and (sol123 ?l) (sol123 ?r)))
(let aux123 ((P ?v ?l)) (match123 ?l ?v))
(:: aux123 (-> (Lambda) Bool))
(:: ck530 (-> (Lambda List) Nat))
(let ck530 ((V ?va) ?lst) (ite-nat (mem ?va ?lst) (Z) (S Z)))
(let ck530 ((C ?ex1 ?ex2) ?lst) (plus (ck530 ?ex1 ?lst) (ck530 ?ex2 ?lst)))
(let ck530 ((P ?va ?ex) ?lst) (ck530 ?ex (Cons ?va ?lst)))
(:: sol530 (-> (Lambda) Bool))
(let sol530 (?m) (eq (ck530 ?m Nil) Z))
